# Environment
NODE_ENV=development

# Public ingress domain (Caddy TLS). Point DNS A/AAAA to the host IP.
# Used by docker-compose to build the stable SAML SP URLs.
PUBLIC_DOMAIN=localhost

# Server
PORT=3000
HOST=localhost
PROTOCOL=https

# SAML Configuration
SAML_SP_ENTITY_ID=https://localhost:3000
SAML_SP_ACS_URL=https://localhost:3000/auth/saml/acs
SAML_SP_SLO_URL=https://localhost:3000/auth/saml/logout

# Generic aliases requested for portable setup
SP_ENTITY_ID=https://localhost:3000
SP_ASSERTION_CONSUMER_SERVICE=https://localhost:3000/saml/acs
SP_SINGLE_LOGOUT_SERVICE=https://localhost:3000/saml/slo
SP_PRIVATE_KEY_PATH=./certificates/sp.key
SP_CERTIFICATE_PATH=./certificates/sp.crt

# Certificates (paths to .pem files)
SAML_SP_CERT_PATH=./certificates/sp.crt
SAML_SP_KEY_PATH=./certificates/sp.key

# Session Management
SESSION_SECRET=your-super-secret-key-change-me-in-production
SESSION_STORE=redis
SESSION_TTL=86400

# Redis (if using Redis for session store)
# Managed providers (Upstash, Railway) give a full URL — set REDIS_URL and it
# takes precedence over the host/port fields below.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Set to true for TLS connections (rediss://) when not using REDIS_URL.
REDIS_TLS=false

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/saml_sso
DATABASE_POOL_SIZE=10
# Set to true for managed Postgres requiring TLS (Neon, Supabase, Railway).
DATABASE_SSL=false

# IdP Configurations
IDP_ENTITY_ID=
IDP_SSO_URL=
IDP_SLO_URL=
IDP_CERTIFICATE_PATH=

AZURE_AD_ENTITY_ID=https://sts.windows.net/{tenant-id}/
AZURE_AD_SSO_URL=https://login.microsoftonline.com/{tenant-id}/saml2
AZURE_AD_CERT_PATH=./certificates/idp-public-certs/azure-ad.crt

OKTA_ENTITY_ID=https://{okta-domain}.okta.com
OKTA_SSO_URL=https://{okta-domain}.okta.com/app/amazon_aws/exk{id}/sso/saml
OKTA_CERT_PATH=./certificates/idp-public-certs/okta.crt

# Logging
LOG_LEVEL=debug
AUDIT_LOG_ENABLED=true

# Security
CLOCK_SKEW_TOLERANCE=60
MIN_ASSERTION_VALIDITY=300
HTTPS_ONLY=true
SECURE_COOKIES=true
SAMSITE_COOKIES=Strict

# Admin panel master key (habilita /admin/*; mínimo 24 caracteres).
# Sin esta clave el panel de administración responde 503.
ADMIN_API_KEY=

# Stripe metered billing (opcional). Sin STRIPE_SECRET_KEY la facturación es no-op.
# Usa una clave de test (sk_test_...) hasta activar live mode.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_METER_EVENT_NAME=saml_authentication

# Cors
CORS_ORIGIN=https://localhost:3000,https://app.example.com

# JWT (if using JWT alongside SAML)
JWT_SECRET=your-jwt-secret-key-change-me
JWT_EXPIRATION=24h
