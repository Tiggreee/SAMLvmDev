{
  "name": "enterprise-saml-sso",
  "version": "1.0.0",
  "description": "Enterprise-grade SAML SSO Service Provider platform",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "build:server": "npm run build",
    "start": "node dist/main.js",
    "test": "vitest",
    "test:smoke": "node scripts/smoke-check.mjs",
    "test:coverage": "vitest --coverage",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check:copilot:agents": "node scripts/validate-copilot-agents.mjs",
    "check:tracked:no-external-repos": "bash scripts/check-tracked-no-external-repos.sh",
    "check:tracked:no-ai-artifacts": "bash scripts/check-tracked-no-ai-artifacts.sh",
    "prod:gate": "node scripts/production-go-no-go.mjs",
    "generate:certs": "ts-node scripts/generate-certificates.ts",
    "generate:metadata": "ts-node scripts/generate-metadata.ts"
  },
  "keywords": [
    "SAML",
    "SSO",
    "Authentication",
    "Enterprise",
    "OIDC",
    "Identity"
  ],
  "author": "Tigre Labs",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/session": "^10.7.0",
    "@xmldom/xmldom": "^0.8.10",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cookie": "^0.5.0",
    "connect-redis": "^7.1.1",
    "crypto-js": "^4.1.1",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "redis": "^4.6.12",
    "samlify": "^2.8.12",
    "passport": "^0.7.0",
    "passport-saml": "^3.2.4",
    "xmlbuilder": "^15.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cookie": "^0.5.4",
    "@types/node": "^20.10.6",
    "@types/passport-saml": "^1.1.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitest/coverage-v8": "^1.1.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
